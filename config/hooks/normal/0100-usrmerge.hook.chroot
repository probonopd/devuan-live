#!/bin/sh
set -e

# Run usrmerge to ensure merged /usr layout for Excalibur
# This is required because Excalibur (based on Debian Bookworm) expects
# /bin, /sbin, /lib to be symlinks to /usr/bin, /usr/sbin, /usr/lib

if command -v usrmerge >/dev/null 2>&1; then
    echo "Running usrmerge to ensure merged /usr layout"
    usrmerge
else
    echo "Warning: usrmerge command not found, skipping"
fi
